{
  "rules": {
    "accounts": {
      ".read": "auth != null && auth.token.email != null",
      "$customerId": {
        ".read": "auth != null && (auth.token.email != null || auth.token.phone_number == data.child('profile/phone').val())",
        ".write": "auth != null && (auth.token.email != null || auth.token.phone_number == data.child('profile/phone').val())",
        ".validate": "newData.hasChildren(['pointBalance', 'depositBalance', 'bonusEligible'])",
        "pointBalance": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "depositBalance": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "profile": {
          "phone": {
            ".read": true
          }
        },
        "requireVerification": {
          ".read": true
        }
      }
    },
    "idPhotos": {
      "$customerId": {
        ".read": "auth != null && auth.token.email != null",
        ".write": "auth != null && auth.token.email != null"
      }
    },
    "storeSettings": {
      ".read": true,
      ".write": "auth != null && auth.token.email != null"
    },
    "$other": {
      ".read": false,
      ".write": false
    },
    "stats": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "weather": {
      ".read": true,
      ".write": false
    },
    "transactions": {
      ".read": "auth != null && auth.token.email != null",
      "$customerId": {
        ".read": "auth != null && (auth.token.email != null || auth.token.phone_number == root.child('accounts').child($customerId).child('profile/phone').val())",
        ".write": "auth != null && (auth.token.email != null || auth.token.phone_number == root.child('accounts').child($customerId).child('profile/phone').val())",
        "$txId": {
          ".validate": "newData.hasChild('ts')"
        }
      }
    }
  }
}
