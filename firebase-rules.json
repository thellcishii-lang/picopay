{
  "rules": {
    "stores": {
      "$storeId": {
        "accounts": {
          ".read": "auth != null && root.child('storeAdmins').child(auth.uid).val() === $storeId",
          "$customerId": {
            ".read": "auth != null && (root.child('storeAdmins').child(auth.uid).val() === $storeId || auth.token.phone_number == root.child('stores').child($storeId).child('accounts').child($customerId).child('profile/phone').val())",
            ".write": "auth != null && root.child('storeAdmins').child(auth.uid).val() === $storeId && (!data.exists() || !newData.exists())",
            ".validate": "newData.hasChildren(['pointBalance', 'depositBalance'])",
            "pointBalance": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "depositBalance": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "profile": {
              ".write": "auth != null && root.child('storeAdmins').child(auth.uid).val() === $storeId"
            },
            "status": {
              ".write": "auth != null && root.child('storeAdmins').child(auth.uid).val() === $storeId"
            },
            "requireVerification": {
              ".write": "auth != null && root.child('storeAdmins').child(auth.uid).val() === $storeId"
            },
            "referredBy": {
              ".write": "auth != null && root.child('storeAdmins').child(auth.uid).val() === $storeId"
            },
            "notifyOptIn": {
              ".write": "auth != null && (root.child('storeAdmins').child(auth.uid).val() === $storeId || auth.token.phone_number == root.child('stores').child($storeId).child('accounts').child($customerId).child('profile/phone').val())"
            },
            "pushTokens": {
              ".write": "auth != null && (root.child('storeAdmins').child(auth.uid).val() === $storeId || auth.token.phone_number == root.child('stores').child($storeId).child('accounts').child($customerId).child('profile/phone').val())"
            }
          }
        },
        "transactions": {
          ".read": "auth != null && root.child('storeAdmins').child(auth.uid).val() === $storeId",
          "$customerId": {
            ".read": "auth != null && (root.child('storeAdmins').child(auth.uid).val() === $storeId || auth.token.phone_number == root.child('stores').child($storeId).child('accounts').child($customerId).child('profile/phone').val())",
            ".write": false,
            ".indexOn": [
              "ts",
              "batchId"
            ]
          }
        },
        "idPhotos": {
          "$customerId": {
            ".read": "auth != null && root.child('storeAdmins').child(auth.uid).val() === $storeId",
            ".write": "auth != null && root.child('storeAdmins').child(auth.uid).val() === $storeId"
          }
        },
        "storeSettings": {
          ".read": true,
          ".write": "auth != null && root.child('storeAdmins').child(auth.uid).val() === $storeId"
        },
        "private": {
          ".read": "auth != null && root.child('storeAdmins').child(auth.uid).val() === $storeId",
          ".write": "auth != null && root.child('storeAdmins').child(auth.uid).val() === $storeId"
        },
        "stats": {
          ".read": "auth != null && root.child('storeAdmins').child(auth.uid).val() === $storeId",
          ".write": false
        },
        "weather": {
          ".read": true,
          ".write": false
        },
        "roles": {
          ".read": "auth != null && root.child('storeAdmins').child(auth.uid).val() === $storeId",
          ".write": "auth != null && root.child('storeAdmins').child(auth.uid).val() === $storeId"
        },
        "roleAuth": {
          ".read": false,
          ".write": "auth != null && root.child('storeAdmins').child(auth.uid).val() === $storeId"
        },
        "ownerCode": {
          ".read": false,
          ".write": false
        },
        "branding": {
          ".read": true,
          ".write": "auth != null && root.child('storeAdmins').child(auth.uid).val() === $storeId"
        },
        "txIndex": {
          ".read": "auth != null && root.child('storeAdmins').child(auth.uid).val() === $storeId",
          ".write": false,
          ".indexOn": [
            "ts"
          ]
        },
        "statusMessages": {
          ".read": true,
          ".write": false
        },
        "pushIndex": {
          ".read": "auth != null && root.child('storeAdmins').child(auth.uid).val() === $storeId",
          "$customerId": {
            ".write": "auth != null && (root.child('storeAdmins').child(auth.uid).val() === $storeId || auth.token.phone_number == root.child('stores').child($storeId).child('accounts').child($customerId).child('profile/phone').val())"
          }
        }
      }
    },
    "customerIndex": {
      "$customerId": {
        ".read": true,
        ".write": "auth != null"
      }
    },
    "storeAdmins": {
      ".read": "auth != null",
      ".write": false
    },
    "storeList": {
      ".read": "auth != null",
      ".write": false
    },
    "meta": {
      ".read": false,
      ".write": false
    },
    "$other": {
      ".read": false,
      ".write": false
    },
    "sharedStatusMessages": {
      ".read": true,
      ".write": false
    }
  }
}
